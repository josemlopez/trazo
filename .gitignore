!/server.py
!/Iniciar.cmd
!/Iniciar.ps1
!/requirements.txt
!/requirements-lock.txt
!/static/
!/static/app.js
!/static/index.html
!/static/style.css
!/static/icon.svg
!/tools/
!/tools/verify.py
